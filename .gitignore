!.env.example
!server/.env.example

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
.venv/
venv/

# ===== Node =====
node_modules/

# ===== 日志与临时文件 =====
*.log
logs/
*.tmp
*.bak

# ===== 系统与编辑器 =====
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

