.page { height: 100vh; display: flex; flex-direction: column; }
.messages { flex: 1; height: 0; box-sizing: border-box; padding: 32rpx 24rpx; }
.welcome { text-align: center; padding: 180rpx 40rpx 60rpx; color: #64748b; }
.logo { margin: 0 auto 28rpx; width: 92rpx; height: 92rpx; line-height: 92rpx; border-radius: 28rpx; background: #2563eb; color: white; font-size: 44rpx; font-weight: 700; }
.welcome-title { color: #0f172a; font-size: 34rpx; font-weight: 650; }
.welcome-sub { margin-top: 16rpx; font-size: 27rpx; }
.row { display: flex; margin: 22rpx 0; }
.row.user { justify-content: flex-end; }
.row.assistant { justify-content: flex-start; }
.bubble { max-width: 78%; padding: 22rpx 26rpx; border-radius: 26rpx; background: white; font-size: 29rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-word; box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, .06); }
.user .bubble { color: white; background: #2563eb; border-bottom-right-radius: 8rpx; }
.assistant .bubble { border-bottom-left-radius: 8rpx; }
.typing { color: #64748b; }
.composer { display: flex; align-items: flex-end; gap: 16rpx; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: white; border-top: 1rpx solid #e2e8f0; }
.input { flex: 1; min-height: 72rpx; max-height: 220rpx; box-sizing: border-box; padding: 17rpx 22rpx; border-radius: 20rpx; background: #f1f5f9; font-size: 29rpx; line-height: 1.45; }
.send { width: 124rpx; height: 72rpx; line-height: 72rpx; padding: 0; border-radius: 20rpx; color: white; background: #2563eb; font-size: 28rpx; }
.send[disabled] { color: #94a3b8; background: #e2e8f0; }
