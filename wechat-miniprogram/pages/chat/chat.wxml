<view class="page">
  <scroll-view class="messages" scroll-y scroll-into-view="{{scrollId}}">
    <view class="welcome" wx:if="{{messages.length === 0}}">
      <view class="logo">D</view>
      <view class="welcome-title">你好，我是 DeepSeek 助手</view>
      <view class="welcome-sub">有什么想聊的，直接问我吧</view>
    </view>
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="row {{item.role}}">
      <view class="bubble">{{item.content}}</view>
    </view>
    <view wx:if="{{loading}}" id="typing" class="row assistant">
      <view class="bubble typing">正在思考…</view>
    </view>
    <view id="bottom"></view>
  </scroll-view>
  <view class="composer">
    <textarea class="input" value="{{input}}" bindinput="onInput" maxlength="4000"
      auto-height fixed="true" placeholder="输入消息…" confirm-type="send" bindconfirm="send" />
    <button class="send" bindtap="send" disabled="{{loading || !canSend}}">发送</button>
  </view>
</view>
