# 复制成 .env 后填写。没有 LLM_API_KEY 时服务仍能启动，
# 但「情绪打分」和「每日建议」会返回明确的未配置提示。

# dashscope(通义千问) | openai(任意 OpenAI 兼容端点) | anthropic
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 留空则用各家默认：dashscope=qwen-plus / openai=gpt-4o-mini / anthropic=claude-sonnet-4-5
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com

# 抓取
CRAWL_INTERVAL_MIN=60
CRAWL_ON_START=1
PER_SOURCE_LIMIT=30

# 服务
QE_HOST=127.0.0.1
QE_PORT=8770
